# Backend Environment Variables for Netlify Functions

# Database (Use external PostgreSQL service)
# Examples:
# - Supabase: https://supabase.com (Free tier available)
# - Railway: https://railway.app (Free tier available)
# - ElephantSQL: https://www.elephantsql.com (Free tier available)
# - Heroku Postgres: https://www.heroku.com/postgres
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Pulse VIP Gateway
PULSE_CLIENT_ID=e1c98954cc404cbcb2868af9b40c7a33
PULSE_API_KEY=4XJoHefFKOr593cnD5_xCto1FfzbQYtvfS2Il6aPAY2nyt8Vm-Qi_NoZ8VhyVocfuCloLEfNBb-7sKjGxFH-0A
PULSE_BASE_URL=https://pulsepayment.app.br
PULSE_WEBHOOK_URL=https://your-site-name.netlify.app/api/webhook/pulse

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (CORS)
FRONTEND_URL=https://your-site-name.netlify.app
